# ===================================
# SK AKSES — Project-Level .gitignore
# ===================================

# ---- Dependencies ----
node_modules/
jspm_packages/
web_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---- Environment Variables ----
.env
.env.*
!.env.example

# ---- Logs ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# ---- Runtime / Process ----
pids/
*.pid
*.seed
*.pid.lock

# ---- Build Outputs ----
# Next.js
.next/
out/
build/

# Nuxt.js
.nuxt/
dist/

# ---- Testing & Coverage ----
coverage/
*.lcov
.nyc_output/

# ---- Database (Local Dev) ----
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ---- Uploads (User-generated content) ----
backend/uploads/*
!backend/uploads/.gitkeep

# ---- IDE & Editor ----
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ---- OS Files ----
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ---- TypeScript ----
*.tsbuildinfo
next-env.d.ts

# ---- Vercel ----
.vercel

# ---- Cache ----
.eslintcache
.stylelintcache
.cache/
.parcel-cache/
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/
.fusebox/

# ---- Docker ----
docker-compose.override.yml

# ---- Misc ----
*.pem
*.tgz
.tern-port
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
